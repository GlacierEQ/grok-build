{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.dev/schemas/mission-contract.schema.json",
  "title": "GlacierEQ Mission Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "objective",
    "completion_contract",
    "status",
    "created_at",
    "artifacts",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "mission_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "completion_contract": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "blocked",
        "verifying",
        "complete",
        "failed",
        "cancelled"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "required"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "required"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "enum": ["pending", "passed", "failed", "skipped"] },
          "evidence": { "type": ["string", "null"] }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
